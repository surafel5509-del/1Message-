    <!-- Onboarding -->
    <string name="onboarding_welcome_title">ወደ 1 MESSAGES እንኳን በደህና መጡ</string>
    <string name="onboarding_welcome_body">ለመልዕክቶችዎ ጸጥ ያለ፣ የግል ቦታ። መለያ የለም፣ ደመና የለም፣ ማስታወቂያ የለም — መልዕክቶችዎ በዚህ ስልክ ላይ ይቆያሉ።</string>
    <string name="onboarding_skip">በኋላ አዘጋጅ</string>
    <string name="onboarding_permissions_title">ጥቂት ፈቃዶች</string>
    <string name="onboarding_permissions_body">1 MESSAGES የመልዕክት መተግበሪያዎ እንዲሆን መልዕክት መላክና ማንበብ ይፈልጋል። ለእያንዳንዱ ባህሪ የሚያስፈልገውን ብቻ እንጠይቃለን፣ በኋላ በAndroid ቅንብሮች ማንኛውንም መሻር ይችላሉ።</string>
    <string name="onboarding_grant_permissions">ፈቃድ ስጥ</string>
    <string name="onboarding_permission_sms_title">መልዕክቶች</string>
    <string name="onboarding_permission_sms_body">የጽሑፍ መልዕክቶችን መላክ፣ መቀበልና ማንበብ።</string>
    <string name="onboarding_permission_contacts_title">እውቂያዎች</string>
    <string name="onboarding_permission_contacts_body">ከቁጥሮች ይልቅ ስሞችንና ፎቶዎችን ለማሳየት።</string>
    <string name="onboarding_permission_notifications_title">ማሳወቂያዎች</string>
    <string name="onboarding_permission_notifications_body">አዲስ መልዕክት ሲመጣ ለማሳወቅና ከማሳወቂያው ላይ መመለስ እንዲቻል።</string>
    <string name="onboarding_permission_phone_title">የሲም መረጃ</string>
    <string name="onboarding_permission_phone_body">ባለሁለት ሲም ስልኮች ትክክለኛውን ሲም ለመጠቀም።</string>
    <string name="onboarding_role_title">1 MESSAGES የመልዕክት መተግበሪያዎ ያድርጉ</string>
    <string name="onboarding_role_body">Android አንድ መተግበሪያ ብቻ በስርዓቱ የመልዕክት መረጃ ቋት ላይ እንዲጽፍ ይፈቅዳል። 1 MESSAGES ነባሪው የመልዕክት መተግበሪያ ሲሆን የገቡ መልዕክቶችን ያስቀምጣል፣ የንባብ ሁኔታን ያስተዳድራል፣ በአስተማማኝ ሁኔታም ይልካል። ይህ ሚና ሳይኖር መተግበሪያው ያሉትን መልዕክቶች ማንበብና መላክ ይችላል፣ ግን የስርዓቱ የመልዕክት መተግበሪያ መሆን አይችልም።</string>
    <string name="onboarding_role_set">ነባሪ አድርግ</string>
    <string name="onboarding_role_done">1 MESSAGES ነባሪ የመልዕክት መተግበሪያዎ ነው</string>
