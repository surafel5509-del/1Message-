    <!-- About -->
    <string name="about_title">ስለ 1MESSAGES</string>
    <string name="about_body">1MESSAGES ከመስመር ውጭ የሚሰራ የመልዕክት መተግበሪያ ነው። መለያ፣ አገልጋይና ማስታወቂያ የለውም። መልዕክቶችዎ በስርዓተ ክወናው በሚጠበቀው የAndroid የመልዕክት መረጃ ቋት ውስጥ ይኖራሉ።</string>
    <string name="about_privacy_policy">የግላዊነት መግለጫ</string>
    <string name="about_privacy_policy_body">ምንም አንሰበስብም። ይህ መተግበሪያ የኢንተርኔት ፈቃድ የለውም፤ ስለዚህ ማንኛውም መልዕክት፣ እውቂያ ወይም የአጠቃቀም ውሂብ ሊላክ አይችልም። የብልሽት ሪፖርት ተሰናክሏል።</string>
