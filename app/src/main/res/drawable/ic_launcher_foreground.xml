<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: one white speech bubble with a soft tail and three aurora dots.

  Everything is inside the 66dp safe zone (21..87 of the 108dp viewport) so circle, squircle
  and rounded-square masks all keep the shape intact. The mark is deliberately single-weight
  and geometric: at 48dp on a home screen, fine detail turns into noise.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft drop shadow under the bubble, offset down by 2dp. -->
    <path
        android:fillColor="#26000000"
        android:pathData="M38,35h32a14,14 0 0 1 14,14v10a14,14 0 0 1 -14,14H57l-9.6,8.1a2.6,2.6 0 0 1 -4.3,-2v-6.1h-5.1A14,14 0 0 1 24,59V49a14,14 0 0 1 14,-14z" />

    <!-- Bubble body -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M38,33h32a14,14 0 0 1 14,14v10a14,14 0 0 1 -14,14H57l-9.6,8.1a2.6,2.6 0 0 1 -4.3,-2v-6.1h-5.1A14,14 0 0 1 24,57V47a14,14 0 0 1 14,-14z" />

    <!-- Three dots, filled with the brand gradient -->
    <path android:pathData="M41,51.5m-3.9,0a3.9,3.9 0 1,0 7.8,0a3.9,3.9 0 1,0 -7.8,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="47"
                android:endX="72"
                android:endY="56">
                <item android:offset="0" android:color="#FF7C4DFF" />
                <item android:offset="1" android:color="#FF2E9BFF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,51.5m-3.9,0a3.9,3.9 0 1,0 7.8,0a3.9,3.9 0 1,0 -7.8,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="47"
                android:endX="72"
                android:endY="56">
                <item android:offset="0" android:color="#FF7C4DFF" />
                <item android:offset="1" android:color="#FF2E9BFF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M67,51.5m-3.9,0a3.9,3.9 0 1,0 7.8,0a3.9,3.9 0 1,0 -7.8,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="47"
                android:endX="72"
                android:endY="56">
                <item android:offset="0" android:color="#FF7C4DFF" />
                <item android:offset="1" android:color="#FF2E9BFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
